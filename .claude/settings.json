{
  "permissions": {
    "allow": ["Bash(uv run pytest:*)", "Bash(uv run python -m evals.*)", "Read", "Grep", "Glob"],
    "deny": ["Read(./.env)", "Bash(rm -rf:*)"]
  },
  "hooks": {
    "PreToolUse": [{"matcher": "Bash|Edit|Write", "hooks": [{"type": "command", "command": "uv run python scripts/hook_tier_check.py"}]}],
    "PostToolUse": [{"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "uv run python scripts/hook_audit.py"}]}],
    "SessionStart": [{"hooks": [{"type": "command", "command": "ls knowledge_vault | head -40"}]}]
  }
}
