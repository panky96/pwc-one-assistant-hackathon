APP_ENV=development              # development | production
AUTH_ENABLED=false               # strict boolean: true | false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUDIENCE=
AZURE_REQUIRED_ROLE=
STATE_STORE_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=pwc-one-assistant

# LLM provider (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_SMALL=anthropic/claude-haiku-4.5
LLM_MODEL_LARGE=anthropic/claude-sonnet-4.5
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./dev.db
# RETRIEVAL_BACKEND=onnx  EMBED_MODEL=BAAI/bge-large-en-v1.5  RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Persistence / cache / tools
# DATABASE_URL=postgresql://pwc:<password>@localhost:5432/pwc_one   (sqlite:///./dev.db for local)
# CACHE_BACKEND=memory            # memory | redis
# MCP_CONFIG=mcp_config.json
# K6_ALLOWED_HOSTS=127.0.0.1,localhost
# K6_MAX_RATE=1000
# POSTGRES_PASSWORD=

# Retrieval (pinned design models) and Azure export
RETRIEVAL_BACKEND=onnx
EMBED_MODEL=BAAI/bge-large-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3
APPLICATIONINSIGHTS_CONNECTION_STRING=
